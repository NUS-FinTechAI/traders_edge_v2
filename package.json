{
  "name": "traders-edge",
  "private": true,
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test",
    "preview": "npm --prefix client run preview",
    "lint:eslint": "npm --prefix client run lint",
    "lint:eslint:fix": "npm --prefix client run lint -- --fix",
    "lint": "npm-run-all -c lint:eslint format:check",
    "fix": "npm-run-all -c lint:eslint:fix format",
    "format": "prettier --write --log-level warn .",
    "format:check": "node scripts/check-prettier.js",
    "typecheck": "npm --prefix client run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.9"
  }
}
