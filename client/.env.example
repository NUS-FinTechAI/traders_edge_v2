# Optional. Defaults to the current hostname on port 8000 in development,
# and the frontend origin in production. Use the same hostname for guest cookies.
# VITE_BACKEND_URL=http://localhost:8000

# Firebase web-app settings (public client identifiers, not Admin credentials).
# Enable Google and Email/Password in Firebase Authentication and authorize
# the frontend hostname. The project ID comes from GET /api/config.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=

# Optional Sentry error reporting; off (and the SDK left out of the build) without a DSN.
# The release defaults to Vercel's VERCEL_GIT_COMMIT_SHA.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
