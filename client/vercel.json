{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "traders-edge-staging.vercel.app" }],
      "destination": "https://traders-edge-api-staging.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://traders-edge-api.onrender.com/api/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
