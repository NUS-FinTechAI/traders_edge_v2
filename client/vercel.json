{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://traders-edge-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|site\\.webmanifest|og-image\\.png|favicon\\.|icon-|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ]
}
